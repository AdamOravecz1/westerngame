[gd_resource type="Shader" format=3 uid="uid://ce6s4wun1mvc2"]

[resource]
code = "shader_type spatial;

uniform sampler2D albedo_texture : source_color;
uniform sampler2D normal_texture : hint_normal;
uniform sampler2D roughness_texture;

uniform vec2 uv_scale = vec2(1.0);

// Hole data
uniform vec2 hole_centers[7];
uniform vec2 hole_sizes[7];

void fragment() {
    vec2 uv = UV * uv_scale;

    // Check all holes
    for (int i = 0; i < 7; i++) {
        vec2 half_size = hole_sizes[i] * 0.5;

        if (
            UV.x > hole_centers[i].x - half_size.x &&
            UV.x < hole_centers[i].x + half_size.x &&
            UV.y > hole_centers[i].y - half_size.y &&
            UV.y < hole_centers[i].y + half_size.y
        ) {
            discard;
        }
    }

    ALBEDO = texture(albedo_texture, uv).rgb;
    NORMAL_MAP = texture(normal_texture, uv).rgb;
    ROUGHNESS = texture(roughness_texture, uv).r;
}"
