[gd_resource type="Shader" format=3 uid="uid://dfjva35tkilc1"]

[resource]
code = "shader_type canvas_item;

uniform float intensity : hint_range(0.0, 1.0) = 0.0;
uniform vec3 blood_color : source_color = vec3(0.8, 0.0, 0.0);

void fragment() {
    vec2 uv = SCREEN_UV;

    // Distance from center
    float dist = distance(uv, vec2(0.5));

    // Make the edges red
    float vignette = smoothstep(0.15, 0.75, dist);

    float alpha = vignette * intensity;

    COLOR = vec4(blood_color, alpha);
}"
